# ========== 大模型（必填）==========
# DeepSeek API Key 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-自行配置key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 网页搜索（可选）==========
# 不填则自动降级为 DuckDuckGo 免费搜索
# Tavily Key 申请地址：https://tavily.com
TAVILY_API_KEY=

# ========== 本地知识库 Embedding ==========
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== 可观测性（可选，Phase 7）==========
# 不填也能用：项目内置本地追踪（每步耗时 / Token / 成本），报告目录下会生成 trace.json。
# 想上报到 LangFuse 才需要填下面两个 Key：
# 1) 到 https://cloud.langfuse.com 免费注册
# 2) 新建一个 Project，在 Settings → API Keys 里创建 Key
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 追踪开关（0 = 关闭本地追踪与上报）
TRACING_ENABLED=1

# ========== 成本核算（可选）==========
# 美元兑人民币汇率，仅用于把成本换算成人民币展示
USD_TO_CNY=7.1
# 覆盖模型单价（美元 / 百万 tokens）。留空则用内置价目表
# 价目表来源：https://api-docs.deepseek.com/quick_start/pricing/
LLM_PRICE_INPUT=
LLM_PRICE_OUTPUT=
